    {
        "id": "n_market_open_format",
        "type": "function",
        "z": "ha_stock_notif_tab",
        "name": "Format Market Open",
        "func": "const d = msg.payload.event;\nconst early = d.early_close;\nconst closeTime = d.close_time;\n\nlet message = 'NYSE is now open.';\nif (early) {\n    message += ' Early close today at ' + closeTime + ' ET.';\n}\n\nmsg.payload = {\n    title: '🔔 Market Open',\n    message: message,\n    color: '#2E7D32',\n    channel: 'Stock Alerts',\n    priority: 'default'\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 500,
        "wires": [["n_notify"]]
    },
    {
        "id": "n_eod2_trigger",
        "type": "server-events",
        "z": "ha_stock_notif_tab",
