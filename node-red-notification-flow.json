    {
        "id": "n_eod2_format",
        "type": "function",
        "z": "ha_stock_notif_tab",
        "name": "Format 401k Update",
        "func": "const d = msg.payload.event;\nconst change = parseFloat(d.day_change).toFixed(2);\nconst pct = parseFloat(d.day_change_pct).toFixed(2);\nconst newVal = parseFloat(d.new_value).toFixed(2);\nconst sign = d.day_change >= 0 ? '+' : '';\nconst arrow = d.day_change >= 0 ? '📈' : '📉';\n\nlet message = '401k ' + sign + '$' + change + ' (' + sign + pct + '%)';\nmessage += '\\nNew value: $' + newVal;\nif (d.deferred) {\n    message += '\\n(Deferred from overnight)';\n}\n\nmsg.payload = {\n    title: arrow + ' 401k Update',\n    message: message,\n    color: d.day_change >= 0 ? '#2E7D32' : '#D32F2F',\n    channel: 'Stock Alerts',\n    priority: 'default'\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 600,
        "wires": [["n_notify"]]
    },
